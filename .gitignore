# ══════════════════════════════════════════════════════════════════
# ChurnGuard v7 — .gitignore
# Proyecto: Sistema Predictivo de Retención · Natalia Stekolnikova
# ══════════════════════════════════════════════════════════════════

# ── PYTHON ────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/
*.whl

# ── JUPYTER ───────────────────────────────────────────────────────
# Checkpoints are local state — never commit
.ipynb_checkpoints/
*/.ipynb_checkpoints/
**/.ipynb_checkpoints/

# ── VIRTUAL ENVIRONMENTS ──────────────────────────────────────────
venv/
env/
.venv/
.env/
.conda/

# ── ENVIRONMENT VARIABLES ─────────────────────────────────────────
.env
.env.local

# ── DATA ──────────────────────────────────────────────────────────
# Raw source — large file (955 KB), always available from Kaggle:
# https://www.kaggle.com/datasets/blastchar/telco-customer-churn
data/raw/WA_Fn-UseC_-Telco-Customer-Churn.csv

# Processed datasets — regenerated by running notebooks 01 + 02
data/processed/telco_clean.csv
data/processed/telco_model_ready.csv

# ── DATABASE ──────────────────────────────────────────────────────
# Regenerated by notebook 03_Load_SQLite
*.db
*.sqlite
*.sqlite3

# ── DASHBOARD — intermediate versions ────────────────────────────
# Keep only the final version committed explicitly
dashboard/Churn_dashboard_3.pbix
dashboard/Churn_final_dashboasd.pbix
dashboard/Churn_Telco_Dashboard_V2.pbix
# Autosave files
*.pbix.autosave
~*.pbix

# ── PRESENTATION — source PNGs are assets, commit them ───────────
# But exclude any leftover script drafts
presentation/presentation_script.md

# ── OUTPUTS — CSV and DB exports regenerated by notebooks ─────────
outputs/telco_clean.csv
outputs/telco_model_ready.csv
outputs/telco_churn.db
outputs/churn_dashboard.*

# ── OS FILES ──────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
Thumbs.db
Desktop.ini
ehthumbs.db

# ── IDE ───────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*.suo
*.user

# Excluded from repository
*.pbix
presentation/*.pdf
docs/ChurnGuard_Documentacion.md
